{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "三角洲行动特勤处制作助手",
  "version": "0.1.0",
  "identifier": "com.coofly.df-desktop-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "三角洲行动特勤处制作助手",
        "width": 1120,
        "height": 374,
        "minWidth": 910,
        "minHeight": 350,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "alwaysOnBottom": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
