{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta Force Craft Assistant",
  "version": "0.1.0",
  "identifier": "com.coofly.df_desktop_assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "三角洲行动特勤处制作助手",
        "width": 1120,
        "height": 244,
        "minWidth": 910,
        "minHeight": 220,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
